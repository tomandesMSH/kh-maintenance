# Zkopíruj na .env (ten se necommituje) a vyplň.

# Vercel > Account Settings > Tokens > Create Token
VERCEL_TOKEN=

# Jen když projekty patří týmu: Vercel > Team Settings > General > Team ID (team_...)
VERCEL_TEAM_ID=

# Doména, která se přepíná, např. muzio.tomandes.eu
CUSTOM_DOMAIN=

PROD_PROJECT=keyboardhero.muzio
MAINT_PROJECT=kh-maintenance
